{
  "name": "score-analyzer",
  "private": true,
  "version": "2.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:version && tsc -b && vite build",
    "preview": "vite preview",
    "check:version": "node scripts/checkVersionConsistency.mjs",
    "verify:stats": "node scripts/verifyStats.mjs",
    "test:parser": "node scripts/testParser.mjs",
    "test:parseReport": "node scripts/testParseReport.mjs",
    "test:analysis-explainer": "node scripts/testAnalysisExplainer.mjs",
    "test:mobile-compatibility": "node scripts/testMobileCompatibility.mjs",
    "test:text-truncation": "node --experimental-strip-types scripts/testTextTruncation.mjs",
    "test:general-engine": "node scripts/testGeneralEngine.mjs",
    "test:general-overview": "node scripts/testGeneralOverview.mjs",
    "test:correlation": "node scripts/testCorrelationAnalyzer.mjs",
    "test:analysis-engine": "node scripts/testAnalysisEngine.mjs",
    "test:sample-data": "node --experimental-loader ./tests/ts-loader-hooks.mjs scripts/testSampleData.ts",
    "test:metric-layer": "node scripts/testMetricLayer.mjs",
    "test:export-analysis": "node scripts/testExportAnalysis.mjs",
    "test:outlier": "node --experimental-loader ./tests/ts-loader-hooks.mjs scripts/testOutlierDetection.ts",
    "test:outlier-details": "node --experimental-loader ./tests/ts-loader-hooks.mjs scripts/testOutlierDetails.ts",
    "check:release-note": "node scripts/checkReleaseNote.mjs",
    "finalAcceptance": "node scripts/finalAcceptance.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
